# ============================================================
# SCHEMATIC PORTFOLIO - SECURE ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port
PORT=4173

# Environment (development | production)
NODE_ENV=production

# HTTPS Enforcement (set to true in production behind reverse proxy)
ENFORCE_HTTPS=true

# Cryptographic Session Secret (min 32 bytes hex)
SESSION_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production

# Session Lifetime in Hours
SESSION_TTL_HOURS=24

# Primary Admin Email Address
ADMIN_EMAIL=alex.stone@example.com

# Abuse Protection & Rate Limiting Thresholds
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINS=15
RATE_LIMIT_API_MAX=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_AI_MAX=10

